# Kopyalayıp .env.local olarak kaydedin. Gerçek anahtarlar asla repoya girmez.

# Site adresi (metadataBase, canonical, sitemap). Boşsa site.ts'teki domain kullanılır.
NEXT_PUBLIC_SITE_URL=https://beyliksurucukursu.netlify.app

# GA4 ölçüm kimliği (G-XXXXXXX). Boşsa analitik hiç yüklenmez.
# Yalnızca kullanıcı çerez onayı verdikten sonra yüklenir.
NEXT_PUBLIC_GA_ID=

# Başvuru formu e-posta gönderimi (Resend). Boşsa: geliştirmede loga yazılır; production'da form hata verip
# kullanıcıyı telefon/WhatsApp'a yönlendirir (başvuru sessizce kaybolmaz).
RESEND_API_KEY=
# Resend'de doğrulanmış gönderici adresi, örn: "Beylik Sürücü Kursu <form@beyliksurucukursu.com>"
LEAD_FROM_EMAIL=
# Başvuruların gideceği adres. Boşsa site.ts'teki e-posta kullanılır.
LEAD_TO_EMAIL=
